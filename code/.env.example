# Copy this file to .env and fill in your API keys

# OpenAI API (required for LLM-based mutation & scanning)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (optional, for Claude-based mutation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace Token (optional, for Qwen-7B scanning)
HF_TOKEN=your_huggingface_token_here

# Snyk API token (optional — required only for the Snyk Agent scanner)
# Format: snyk_uat.<8-hex>.<base64...>  (get it from `snyk config get api` or the Snyk web console)
SNYK_TOKEN=your_snyk_token_here
