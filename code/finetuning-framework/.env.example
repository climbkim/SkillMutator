# Skill-Scanner-Finetune environment variables
# Copy this file to `.env` and fill in your values.

# --- LLM provider keys ---
# Used by the GPT-5.4 judge during evaluation, by the teacher model during
# data preparation, and by any proprietary baselines.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- HuggingFace (model downloads) ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Weights & Biases (optional, for training run tracking) ---
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
WANDB_PROJECT=<your-wandb-project>

# --- Local paths ---
# Where checkpoints, training logs, and dataset shards are written.
OUTPUT_DIR=./output
DATASET_DIR=./dataset

# --- vLLM inference endpoint ---
# When the scanner is run against a self-hosted vLLM server, set its OpenAI-
# compatible URL here. Leave blank to use a local in-process model.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=token
