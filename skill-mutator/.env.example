# Skill-Mutator environment variables
# Copy this file to `.env` and fill in your values.

# --- LLM provider keys (at least one required) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional scanner integrations ---
# Snyk Agent Scan integration
SNYK_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace (for HF inference router or custom-hosted scanners)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Local data paths (override defaults) ---
# Where mutated skills, scan reports, and analysis outputs are written.
SKILL_MUTATOR_DATA_DIR=./data
